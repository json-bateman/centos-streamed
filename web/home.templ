package web

import (
	"fmt"
	"strings"
)

templ osLogo(osName string) {
	switch  {
		case strings.Contains(strings.ToLower(osName), "centos"):
			<img src={ StaticPath("images/os/centos.png") } alt="CentOS" width="24" height="24"/>
		case strings.Contains(strings.ToLower(osName), "darwin") || strings.Contains(strings.ToLower(osName), "mac"):
			<img src={ StaticPath("images/os/apple.png") } alt="macOS" width="24" height="24"/>
	}
}

templ Page(info ServerInfo, procs []Process) {
	@Layout("system monitor") {
		@Home(info, procs)
	}
}

templ Home(info ServerInfo, procs []Process) {
	<main id="home-morph-target" data-init={ fmt.Sprintf("@get('%s')", SseUrl) }>
		<h1>{ info.Name }</h1>
		@ServerInfoCards(info)
		@ProcessTable(procs)
	</main>
}

templ ServerInfoCards(info ServerInfo) {
	<section>
		<div class="flex gap-2">
			This Webapp running
			<img src={ StaticPath("images/go-logo-blue.png") } alt="Goroutines" width="60" height="24"/>
		</div>
		<div class="flex gap-4">
			<span data-neo-card-description>Version: { info.GoVersion }</span>
			<span data-neo-card-description>Goroutines: { fmt.Sprint(info.Goroutines) }</span>
		</div>
		<div class="server-info">
			<header class="flex gap-2 items-center">
				<img width="40px" height="40px" src={ StaticPath("icons/server.svg") } alt="Server time"/>
				<h3>Live server info</h3>
			</header>
			<div class="flex gap-2">
				@osLogo(info.OS)
				Operating System
			</div>
			<div>{ info.OS }</div>
			<div class="flex gap-2">
				<img src={ StaticPath("images/Linux.png") } alt="Linux" width="24" height="24"/>
				Kernel
			</div>
			<div>{ info.Kernel }</div>
			<div class="flex gap-2">
				<img src={ StaticPath("images/cpu.png") } alt="Architecture" width="24" height="24"/>
				Architecture	
			</div>
			<div>{ info.Arch }</div>
		</div>
	</section>
}

// ProcessTable is patched over SSE with a fresh /proc snapshot, sorted by memory.
templ ProcessTable(procs []Process) {
	<section>
		<h3>Processes — top { fmt.Sprint(len(procs)) } by memory</h3>
		<table>
			<thead>
				<tr>
					<th>PID</th>
					<th>User</th>
					<th>Command</th>
					<th>State</th>
					<th>Threads</th>
					<th>Memory</th>
					<th>CPU time</th>
				</tr>
			</thead>
			<tbody>
				if len(procs) == 0 {
					<tr><td colspan="7">No processes found (is this running on Linux?).</td></tr>
				}
				for _, p := range procs {
					<tr>
						<td>{ fmt.Sprint(p.PID) }</td>
						<td>{ p.User }</td>
						<td>{ p.Command }</td>
						<td>{ p.State }</td>
						<td>{ fmt.Sprint(p.Threads) }</td>
						<td>{ p.RSS }</td>
						<td>{ p.CPUTime }</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
}
