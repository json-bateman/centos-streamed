package web

import (
	"fmt"
	"strings"
)

templ card(iconName string) {
	<div class="home-card">
		<header>
			<neo-icon name={ fmt.Sprintf("%s", iconName) } data-neo-icon-base="/static/icons"></neo-icon>
		</header>
		{ children... }
	</div>
}

templ osLogo(osName string) {
	switch  {
		case strings.Contains(strings.ToLower(osName), "centos"):
			<img class="os-logo" src={ StaticPath("images/os/centos.png") } alt="CentOS" width="20" height="20"/>
		case strings.Contains(strings.ToLower(osName), "darwin") || strings.Contains(strings.ToLower(osName), "mac"):
			<img class="os-logo" src={ StaticPath("images/os/apple.png") } alt="macOS" width="20" height="20"/>
	}
}

templ Page(info ServerInfo, procs []Process) {
	@Layout("system monitor") {
		@Home(info, procs)
	}
}

templ Home(info ServerInfo, procs []Process) {
	<main id="home-morph-target" data-init={ fmt.Sprintf("@get('%s')", SseUrl) }>
		<h1>{ info.Name }</h1>
		<h3>live system monitor</h3>
		@ServerInfoCards(info)
		@ProcessTable(procs)
	</main>
}

templ ServerInfoCards(info ServerInfo) {
	<section>
		<h3>Live server info</h3>
		<div class="grid-3">
			<neo-card class="custom-card">
				<div data-neo-card-inner>
					<div data-neo-card-media>
						@osLogo(info.OS)
					</div>
					<div data-neo-card-header>
						<h3 data-neo-card-title>Operating System</h3>
						<p data-neo-card-description>{ info.OS }</p>
					</div>
				</div>
			</neo-card>
			<neo-card class="custom-card">
				<div data-neo-card-inner>
					<div data-neo-card-media>
						<img class="os-logo" src={ StaticPath("icons/linux.svg") } alt="Kernel"/>
					</div>
					<div data-neo-card-header>
						<h3 data-neo-card-title>Kernel</h3>
						<p data-neo-card-description>{ info.Kernel }</p>
					</div>
				</div>
			</neo-card>
			<neo-card class="custom-card">
				<div data-neo-card-inner>
					<div data-neo-card-media>
						<img class="os-logo" src={ StaticPath("icons/amd64.svg") } alt="Architecture"/>
					</div>
					<div data-neo-card-header>
						<h3 data-neo-card-title>Architecture</h3>
						<p data-neo-card-description>{ info.Arch }</p>
					</div>
				</div>
			</neo-card>
			<neo-card class="custom-card">
				<div data-neo-card-inner>
					<div data-neo-card-media>
						<img class="os-logo" src={ StaticPath("icons/cpu.svg") } alt="CPUs"/>
					</div>
					<div data-neo-card-header>
						<h3 data-neo-card-title>CPUs</h3>
						<p data-neo-card-description>{ fmt.Sprint(info.CPUs) }</p>
					</div>
				</div>
			</neo-card>
			<neo-card class="custom-card">
				<div data-neo-card-inner>
					<div data-neo-card-media>
						<img class="os-logo" src={ StaticPath("icons/ram.svg") } alt="Memory"/>
					</div>
					<div data-neo-card-header>
						<h3 data-neo-card-title>Memory</h3>
						<p data-neo-card-description>{ info.MemFree } free of { info.MemTotal }</p>
					</div>
				</div>
			</neo-card>
			<neo-card class="custom-card">
				<div data-neo-card-inner>
					<div data-neo-card-media>
						<img class="os-logo" src={ StaticPath("icons/clock.svg") } alt="Uptime"/>
					</div>
					<div data-neo-card-header>
						<h3 data-neo-card-title>Uptime</h3>
						<p data-neo-card-description>{ info.Uptime }</p>
					</div>
				</div>
			</neo-card>
			<neo-card class="custom-card">
				<div data-neo-card-inner>
					<div data-neo-card-media>
						<img class="os-logo" src={ StaticPath("images/go-logo-blue.png") } alt="Goroutines"/>
					</div>
					<div data-neo-card-header>
						<h3 data-neo-card-title>Golang Stats</h3>
						<div class="flex gap-4">
							<p data-neo-card-description>Goroutines: { fmt.Sprint(info.Goroutines) }</p>
							<p data-neo-card-description>Version: { info.GoVersion }</p>
						</div>
					</div>
				</div>
			</neo-card>
			<neo-card class="custom-card">
				<div data-neo-card-inner>
					<div data-neo-card-media>
						<img class="os-logo" src={ StaticPath("icons/server.svg") } alt="Server time"/>
					</div>
					<div data-neo-card-header>
						<h3 data-neo-card-title>Server time</h3>
						<p data-neo-card-description>{ info.Now }</p>
					</div>
				</div>
			</neo-card>
		</div>
	</section>
}

// ProcessTable is patched over SSE with a fresh /proc snapshot, sorted by memory.
templ ProcessTable(procs []Process) {
	<section>
		<h3>Processes — top { fmt.Sprint(len(procs)) } by memory</h3>
		<table>
			<thead>
				<tr>
					<th>PID</th>
					<th>User</th>
					<th>Command</th>
					<th>State</th>
					<th>Threads</th>
					<th>Memory</th>
					<th>CPU time</th>
				</tr>
			</thead>
			<tbody>
				if len(procs) == 0 {
					<tr><td colspan="7">No processes found (is this running on Linux?).</td></tr>
				}
				for _, p := range procs {
					<tr>
						<td>{ fmt.Sprint(p.PID) }</td>
						<td>{ p.User }</td>
						<td>{ p.Command }</td>
						<td>{ p.State }</td>
						<td>{ fmt.Sprint(p.Threads) }</td>
						<td>{ p.RSS }</td>
						<td>{ p.CPUTime }</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
}
