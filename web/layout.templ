package web

import "strings"

// BrandLogo renders the masthead brand for the host OS: the CentOS Stream
templ BrandLogo(osName string) {
	switch  {
		case strings.Contains(strings.ToLower(osName), "darwin") || strings.Contains(strings.ToLower(osName), "mac"):
			<img class="brand-logo" src={ StaticPath("images/os/apple.png") } alt="macOS" width="48" height="48"/>
			<span class="brand-stream">macOS</span>
		default:
			<img class="brand-logo" src={ StaticPath("images/centos-stream.png") } alt="CentOS Stream" width="163" height="48"/>
			<span class="brand-stream">Stream</span>
	}
}

templ Layout(title string) {
	<!DOCTYPE html>
	<html
		class="theme-sunshine"
		data-signals="{_mode: (localStorage.getItem('neo-mode') || 'system')}"
		lang="en"
	>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="icon" type="image/png" href={ StaticPath("images/centos-favicon.png") }/>
			<!--
			  Morpheus color-mode controller. Sunshine defines :root.theme-sunshine
			  (light) and :root.theme-sunshine.dark (dark), so a mode is just the
			  light/dark class on <html>. We apply the saved mode before CSS paints
			  to avoid a flash, and keep "system" in sync with the OS.
			-->
			<script>
                (function () {
                    var root = document.documentElement;
                    var mq = window.matchMedia('(prefers-color-scheme: dark)');
                    function isDark(mode) {
                        return mode === 'dark' || (mode === 'system' && mq.matches);
                    }
                    function paint(mode) {
                        var dark = isDark(mode);
                        root.classList.toggle('dark', dark);
                        root.classList.toggle('light', !dark);
                    }
                    window.morpheusMode = {
                        apply: function (mode) {
                            localStorage.setItem('neo-mode', mode);
                            paint(mode);
                        },
                        saved: function () {
                            return localStorage.getItem('neo-mode') || 'system';
                        },
                    };
                    paint(window.morpheusMode.saved());
                    mq.addEventListener('change', function () {
                        if (window.morpheusMode.saved() === 'system') paint('system');
                    });
                })();
            </script>
			<link href={ StaticPath("css/main.css") } rel="stylesheet"/>
		</head>
		<body>
			<div id="app-shell">
				<neo-sidebar id="app-sidebar" role="complementary" tabindex="-1">
					<!-- Morpheus-style color mode switcher (light / system / dark). -->
					<neo-buttongroup
						value="system"
						aria-label="Color mode"
						role="radiogroup"
						data-attr:value="$_mode"
						data-on:neo-buttongroup-change="$_mode = evt.detail.value; window.morpheusMode.apply(evt.detail.value)"
					>
						<neo-button value="light" aria-label="Light" role="radio" tabindex="0">☀</neo-button>
						<neo-button value="system" aria-label="System" role="radio" tabindex="0">◐</neo-button>
						<neo-button value="dark" aria-label="Dark" role="radio" tabindex="0">☾</neo-button>
					</neo-buttongroup>
					<div>something</div>
				</neo-sidebar>
				<div id="app-shell-main">
					<header id="masthead">
						<neo-button aria-label="Toggle sidebar" data-on:click="document.getElementById('app-sidebar').toggle()" role="button" tabindex="0">
							<neo-icon name="menu" data-neo-icon-base="/static/icons">
								<template shadowrootmode="open">
									<svg class="lucide lucide-menu" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" part="svg">
										<path d="M4 5h16"></path>
										<path d="M4 12h16"></path>
										<path d="M4 19h16"></path>
									</svg>
								</template>
							</neo-icon>
						</neo-button>
						@BrandLogo(osPrettyName())
					</header>
					<div class="page-shell">
						{ children... }
					</div>
				</div>
			</div>
		</body>
		<!-- Datastar v1.0.0-RC.8 -->
		<script type="module" src={ StaticPath("js/datastar.js") }></script>
		<!-- Morpheus bundle — classic script (registers the <neo-*> custom elements). -->
		<script defer src={ StaticPath("js/bundle.js") }></script>
	</html>
}
