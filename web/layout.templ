package web

import "strings"

templ BrandLogo(osName string) {
	switch  {
		case strings.Contains(strings.ToLower(osName), "darwin") || strings.Contains(strings.ToLower(osName), "mac"):
			<img class="svg" src={ StaticPath("icons/apple.svg") } alt="macOS" width="48" height="48"/>
			<span class="brand-stream">macOS</span>
		default:
			<img src={ StaticPath("images/centos-stream.png") } alt="CentOS Stream" width="163" height="48"/>
			<span class="brand-stream">Stream</span>
	}
}

templ Layout(title, commitHash string) {
	<!DOCTYPE html>
	<html
		data-signals="{_mode: localStorage.getItem('neo-mode') || 'dark'}"
		data-attr:class="'theme-sunshine ' + ($_mode === 'dark' ? 'dark' : 'light')"
		lang="en"
	>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="icon" type="image/png" href={ StaticPath("images/centos-favicon.png") }/>
			<script>
				const mode = localStorage.getItem('neo-mode');
				document.documentElement.className = 'theme-sunshine ' + mode;
			</script>
			<link href={ StaticPath("css/main.css") } rel="stylesheet"/>
		</head>
		<datastar-inspector></datastar-inspector>
		<body>
			<div id="app-shell">
				<neo-sidebar id="app-sidebar" role="complementary" tabindex="-1">
					<!-- Morpheus-style color mode switcher (light / dark). -->
					<header id="sidebar-header">
						<neo-buttongroup
							value="system"
							aria-label="Color mode"
							role="radiogroup"
							data-attr:value="$_mode"
							data-on:neo-buttongroup-change="
                $_mode = evt.detail.value;
                try { localStorage.setItem('neo-mode', $_mode); } catch (_) {};
            "
						>
							<neo-button value="light" aria-label="Light" role="radio" tabindex="0">☀</neo-button>
							<neo-button value="dark" aria-label="Dark" role="radio" tabindex="0">☾</neo-button>
						</neo-buttongroup>
					</header>
					<a data-neo-link variant="button-ghost" class="app-nav-link" href="/">/home</a>
					<a data-neo-link variant="button-ghost" class="app-nav-link" href={ ProcessesUrl }>/proc</a>
					<a data-neo-link variant="button-ghost" class="app-nav-link" href={ EtcUrl }>/etc</a>
					<footer id="sidebar-footer">
						<span>{ commitHash }</span>
					</footer>
				</neo-sidebar>
				<div id="app-shell-main">
					<header id="masthead">
						<neo-button aria-label="Toggle sidebar" data-on:click="document.getElementById('app-sidebar').toggle()" role="button" tabindex="0">
							<neo-icon name="menu" data-neo-icon-base="/static/icons">
								<template shadowrootmode="open">
									<svg class="lucide lucide-menu" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" part="svg">
										<path d="M4 5h16"></path>
										<path d="M4 12h16"></path>
										<path d="M4 19h16"></path>
									</svg>
								</template>
							</neo-icon>
						</neo-button>
						@BrandLogo(osPrettyName())
					</header>
					<div class="page-shell">
						{ children... }
					</div>
				</div>
			</div>
		</body>
		<!-- Datastar Inspector-->
		<script type="module" src={ StaticPath("js/datastar-inspector.js") }></script>
		<!-- Datastar v1.0.0-RC.8 -->
		<script type="module" src={ StaticPath("js/datastar.js") }></script>
		<!-- Morpheus bundle — classic script (registers the <neo-*> custom elements). -->
		<script defer src={ StaticPath("js/bundle.js") }></script>
	</html>
}
