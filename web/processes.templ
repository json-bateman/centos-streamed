package web

import "fmt"

templ ProcessesPage(procs *ProcessInfo) {
	@Layout("/procs", CommitHash) {
		<main id="morph-target" data-init={ fmt.Sprintf("@get('%s/sse')", ProcessesUrl) }>
			<h3>Processes</h3>
			@ProcessesTable(procs)
		</main>
	}
}

// ProcessTable is patched over SSE with a fresh /proc snapshot, sorted by memory.
templ ProcessesTable(procs *ProcessInfo) {
	<section>
		<h4 class="color-muted">Top { fmt.Sprint(len(procs.Processes)) } By Memory</h4>
		<div class="progress-box">
			<neo-progress
				min="0"
				max="100"
				style="max-width: 240px"
				data-attr:value={ fmt.Sprint(int(100 - (100 * procs.MemInfo.MemFree / procs.MemInfo.MemTotal))) }
				label="Memory Used"
				unit="%"
				easing="500ms cubic-bezier(0.16, 1, 0.3, 1)"
			>
				<span data-neo-progress-mark="100">
					{ fmt.Sprintf("%.2f",procs.MemInfo.MemTotal-procs.MemInfo.MemFree ) }GiB
					&nbsp;of&nbsp;
					{ fmt.Sprintf("%.2f", procs.MemInfo.MemTotal) }GiB
				</span>
			</neo-progress>
		</div>
		<table>
			<thead>
				<tr>
					<th>PID</th>
					<th>User</th>
					<th>Command</th>
					<th>Memory</th>
					<th>Threads</th>
					<th>State</th>
					<th>CPU time</th>
				</tr>
			</thead>
			<tbody>
				if len(procs.Processes) == 0 {
					<tr><td colspan="7">No processes found (is this running on Linux?).</td></tr>
				}
				for _, p := range procs.Processes {
					<tr>
						<td>{ fmt.Sprint(p.PID) }</td>
						<td>{ p.User }</td>
						<td>{ p.Command }</td>
						<td>{ p.RSS }</td>
						<td>{ fmt.Sprint(p.Threads) }</td>
						<td>{ p.State }</td>
						<td>{ p.CPUTime }</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
}
